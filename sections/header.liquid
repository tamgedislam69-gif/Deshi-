{% comment %}
  DeshiStore Professional Header & Navigation Section
{% endcomment %}

<header class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-2xs">
  <div class="max-w-7xl mx-auto px-4 py-3.5 flex items-center justify-between gap-4">
    
    <!-- Brand Logo / Name -->
    <a href="/" class="flex items-center gap-2 group">
      {% if section.settings.logo != blank %}
        <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" class="h-10 w-auto object-contain" />
      {% else %}
        <div class="w-10 h-10 rounded-2xl bg-slate-900 text-amber-400 font-black text-xl flex items-center justify-center shadow-md">
          {{ shop.name | slice: 0, 1 | uppercase }}
        </div>
        <span class="font-black text-xl text-slate-900 tracking-tight group-hover:text-amber-600 transition-colors">
          {{ shop.name }}
        </span>
      {% endif %}
    </a>

    <!-- Category / Navigation Links (Desktop) -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-bold text-slate-700">
      <a href="/" class="hover:text-amber-600 transition-colors">হোম</a>
      <a href="/collections/all" class="hover:text-amber-600 transition-colors">সব পণ্য</a>
      <a href="#featured-products" class="hover:text-amber-600 transition-colors">নতুন কালেকশন</a>
      <a href="/pages/order-tracking" class="hover:text-amber-600 transition-colors flex items-center gap-1 text-amber-600">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"/><circle cx="12" cy="10" r="3"/></svg>
        <span>অর্ডার ট্র্যাক</span>
      </a>
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-3">
      {% if section.settings.phone_number != blank %}
        <a href="tel:{{ section.settings.phone_number }}" class="hidden sm:flex items-center gap-1.5 bg-slate-100 hover:bg-slate-200 text-slate-900 font-bold px-3 py-2 rounded-xl text-xs transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>{{ section.settings.phone_number }}</span>
        </a>
      {% endif %}

      <button type="button" onclick="openCODModal()" class="bg-amber-500 hover:bg-amber-600 text-slate-950 font-black px-4 py-2 rounded-xl text-xs shadow-md transition-all cursor-pointer flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span>অর্ডার করুন</span>
      </button>
    </div>

  </div>
</header>

{% schema %}
{
  "name": "Header & Navigation",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Store Logo Image"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Hotline Phone Number",
      "default": "01700-000000"
    }
  ],
  "presets": [
    {
      "name": "Header & Navigation"
    }
  ]
}
{% endschema %}
