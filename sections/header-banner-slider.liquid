{% comment %}
  ==============================================================================
  Custom Header Banner with Native Menu Drawer & Dynamic Carousel Slider
  File: sections/header-banner-slider.liquid
  ==============================================================================
{% endcomment %}

<!-- SECTION CSS (BEM Architecture) -->
<style>
  :root {
    --header-bg: {{ section.settings.header_bg_color | default: '#0f172a' }};
    --header-text: {{ section.settings.header_text_color | default: '#ffffff' }};
    --header-accent: {{ section.settings.accent_color | default: '#f59e0b' }};
    --announcement-bg: {{ section.settings.announcement_bg | default: '#020617' }};
    --announcement-text: {{ section.settings.announcement_text_color | default: '#f8fafc' }};
  }

  /* Header Wrapper */
  .c-header-wrapper {
    position: relative;
    width: 100%;
    z-index: 40;
  }
  .c-header-wrapper--sticky {
    position: sticky;
    top: 0;
  }

  /* Announcement Bar */
  .c-announcement {
    background-color: var(--announcement-bg);
    color: var(--announcement-text);
    padding: 8px 16px;
    font-size: 12px;
    font-weight: 600;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .c-announcement__container {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .c-announcement__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(244, 63, 94, 0.2);
    color: #fb7185;
    padding: 2px 8px;
    border-radius: 9999px;
    border: 1px solid rgba(244, 63, 94, 0.3);
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
  }
  .c-announcement__dot {
    width: 6px;
    height: 6px;
    background-color: #f43f5e;
    border-radius: 50%;
    animation: c-ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  /* Header Main Bar */
  .c-header {
    background: {{ section.settings.header_bg_gradient | default: 'var(--header-bg)' }};
    color: var(--header-text);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
  }
  .c-header__container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  /* Logo & Hamburger */
  .c-header__left {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .c-header__hamburger {
    background: transparent;
    border: none;
    color: currentColor;
    cursor: pointer;
    padding: 8px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease;
  }
  .c-header__hamburger:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }
  .c-header__logo-link {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: inherit;
  }
  .c-header__logo-img {
    height: auto;
    max-height: 50px;
    object-fit: contain;
  }
  .c-header__logo-fallback {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--header-accent);
    color: #020617;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    font-size: 20px;
  }
  .c-header__title {
    font-size: 18px;
    font-weight: 900;
    letter-spacing: -0.02em;
  }

  /* Desktop Nav Menu */
  .c-header__nav {
    display: none;
  }
  @media (min-width: 1024px) {
    .c-header__nav {
      display: flex;
      align-items: center;
      gap: 24px;
    }
  }
  .c-header__nav-link {
    color: var(--header-text);
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: color 0.2s ease;
  }
  .c-header__nav-link:hover,
  .c-header__nav-link.is-active {
    color: var(--header-accent);
  }

  /* Search Bar */
  .c-header__search {
    display: none;
    flex: 1;
    max-width: 360px;
    position: relative;
  }
  @media (min-width: 768px) {
    .c-header__search {
      display: block;
    }
  }
  .c-header__search-input {
    width: 100%;
    background-color: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #ffffff;
    padding: 8px 16px 8px 38px;
    border-radius: 9999px;
    font-size: 12px;
    outline: none;
    transition: border-color 0.2s ease;
  }
  .c-header__search-input:focus {
    border-color: var(--header-accent);
  }
  .c-header__search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    opacity: 0.6;
  }

  /* Actions Right */
  .c-header__actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .c-header__action-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: var(--header-accent);
    color: #020617;
    padding: 8px 16px;
    border-radius: 9999px;
    font-size: 12px;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
    transition: transform 0.2s ease, background-color 0.2s ease;
  }
  .c-header__action-btn:hover {
    transform: translateY(-1px);
    filter: brightness(1.1);
  }
  .c-header__cart-count {
    background-color: #020617;
    color: var(--header-accent);
    padding: 2px 8px;
    border-radius: 9999px;
    font-size: 11px;
    font-family: monospace;
  }

  /* Drawer Menu Overlay */
  .c-drawer {
    position: fixed;
    inset: 0;
    z-index: 100;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .c-drawer.is-open {
    visibility: visible;
    opacity: 1;
  }
  .c-drawer__overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(2, 6, 23, 0.75);
    backdrop-filter: blur(4px);
  }
  .c-drawer__content {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 100%;
    max-width: 340px;
    background: {{ section.settings.drawer_bg_gradient | default: 'linear-gradient(180deg, #0f172a 0%, #020617 100%)' }};
    color: #ffffff;
    box-shadow: 10px 0 30px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    transform: translateX(-100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .c-drawer.is-open .c-drawer__content {
    transform: translateX(0);
  }
  .c-drawer__header {
    padding: 16px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .c-drawer__close {
    background: transparent;
    border: none;
    color: #ffffff;
    cursor: pointer;
    padding: 6px;
    border-radius: 50%;
  }
  .c-drawer__nav {
    flex: 1;
    overflow-y: auto;
    padding: 16px 20px;
  }
  .c-drawer__menu-list,
  .c-drawer__submenu-list,
  .c-drawer__grandchild-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .c-drawer__menu-item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
  .c-drawer__link-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .c-drawer__link,
  .c-drawer__childlink,
  .c-drawer__grandchildlink {
    display: block;
    padding: 12px 0;
    color: #cbd5e1;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
  }
  .c-drawer__link:hover,
  .c-drawer__link.is-active {
    color: var(--header-accent);
  }
  .c-drawer__toggle-btn {
    background: transparent;
    border: none;
    color: #94a3b8;
    cursor: pointer;
    padding: 8px;
    transition: transform 0.2s ease;
  }
  .c-drawer__toggle-btn[aria-expanded="true"] {
    transform: rotate(180deg);
  }
  .c-drawer__submenu-list {
    padding-left: 16px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 8px;
  }

  /* Carousel Section */
  .c-carousel {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: #020617;
  }
  .c-carousel--small { min-height: 320px; }
  .c-carousel--medium { min-height: 480px; }
  .c-carousel--large { min-height: 640px; }
  
  .c-carousel__track-container {
    width: 100%;
    height: 100%;
  }
  .c-carousel__track {
    display: flex;
    transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
    width: 100%;
  }
  .c-carousel__slide {
    min-width: 100%;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 20px;
    box-sizing: border-box;
  }
  .c-carousel__image-wrapper {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .c-carousel__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .c-carousel__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
  }
  .c-carousel__content-container {
    position: relative;
    z-index: 3;
    max-width: 1280px;
    width: 100%;
    margin: 0 auto;
  }
  .c-carousel__content {
    max-width: 600px;
  }
  .c-carousel__slide--left .c-carousel__content { margin-right: auto; text-align: left; }
  .c-carousel__slide--center .c-carousel__content { margin: 0 auto; text-align: center; }
  .c-carousel__slide--right .c-carousel__content { margin-left: auto; text-align: right; }

  .c-carousel__badge {
    display: inline-block;
    background-color: var(--header-accent);
    color: #020617;
    font-size: 11px;
    font-weight: 900;
    padding: 4px 12px;
    border-radius: 9999px;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .c-carousel__heading {
    font-size: 28px;
    line-height: 1.2;
    font-weight: 900;
    margin: 0 0 12px 0;
  }
  @media (min-width: 768px) {
    .c-carousel__heading { font-size: 42px; }
  }
  .c-carousel__subheading {
    font-size: 14px;
    line-height: 1.6;
    margin: 0 0 24px 0;
    opacity: 0.9;
  }
  .c-carousel__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .c-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    border-radius: 12px;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.2s ease;
  }
  .c-btn:hover { transform: translateY(-2px); }
  .c-btn--primary { background-color: var(--header-accent); color: #020617; }
  .c-btn--secondary { background-color: rgba(255, 255, 255, 0.2); color: #ffffff; backdrop-filter: blur(8px); }

  /* Navigation Controls */
  .c-carousel__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 4;
    background: rgba(15, 23, 42, 0.6);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(4px);
    transition: background 0.2s ease;
  }
  .c-carousel__arrow:hover { background: var(--header-accent); color: #020617; }
  .c-carousel__arrow--prev { left: 16px; }
  .c-carousel__arrow--next { right: 16px; }

  .c-carousel__dots {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 4;
    display: flex;
    gap: 8px;
  }
  .c-carousel__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: width 0.3s ease, background 0.3s ease;
  }
  .c-carousel__dot.is-active {
    width: 28px;
    border-radius: 9999px;
    background: var(--header-accent);
  }

  @keyframes c-ping {
    75%, 100% { transform: scale(2); opacity: 0; }
  }
</style>

<!-- SECTION CONTENT -->
<div class="c-header-wrapper {% if section.settings.enable_sticky_header %}c-header-wrapper--sticky{% endif %}">
  
  <!-- Announcement Bar -->
  {% if section.settings.show_announcement_bar %}
    <div class="c-announcement">
      <div class="c-announcement__container">
        <div style="display: flex; align-items: center; gap: 8px;">
          {% if section.settings.show_live_badge %}
            <span class="c-announcement__badge">
              <span class="c-announcement__dot"></span>
              LIVE
            </span>
          {% endif %}
          <span>{{ section.settings.announcement_message }}</span>
        </div>
        {% if section.settings.show_hotline and section.settings.hotline_number != blank %}
          <div>
            <a href="tel:{{ section.settings.hotline_number }}" style="color: inherit; text-decoration: none; font-weight: 700;">
              📞 {{ section.settings.hotline_number }}
            </a>
          </div>
        {% endif %}
      </div>
    </div>
  {% endif %}

  <!-- Main Header -->
  <header class="c-header">
    <div class="c-header__container">
      
      <!-- Left: Hamburger & Logo -->
      <div class="c-header__left">
        {% if section.settings.enable_drawer_menu %}
          <button type="button" class="c-header__hamburger" data-drawer-open aria-label="Open menu">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
          </button>
        {% endif %}

        <a href="{{ routes.root_url }}" class="c-header__logo-link">
          {% if section.settings.logo != blank %}
            <img src="{{ section.settings.logo | image_url: width: section.settings.logo_width }}" alt="{{ shop.name }}" class="c-header__logo-img">
          {% else %}
            <div class="c-header__logo-fallback">
              {{ shop.name | slice: 0, 1 | uppercase }}
            </div>
            <span class="c-header__title">{{ shop.name }}</span>
          {% endif %}
        </a>
      </div>

      <!-- Center: Search Bar -->
      {% if section.settings.show_search_bar %}
        <div class="c-header__search">
          <form action="{{ routes.search_url }}" method="get">
            <svg class="c-header__search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            <input type="text" name="q" placeholder="পণ্য খুঁজুন..." class="c-header__search-input">
          </form>
        </div>
      {% endif %}

      <!-- Center-Right: Desktop Menu Navigation -->
      <nav class="c-header__nav">
        {% for link in linklists[section.settings.menu].links %}
          <a href="{{ link.url }}" class="c-header__nav-link {% if link.active %}is-active{% endif %}">
            {{ link.title }}
          </a>
        {% endfor %}
      </nav>

      <!-- Right Actions: Cart & Account -->
      <div class="c-header__actions">
        {% if section.settings.show_account_icon and shop.customer_accounts_enabled %}
          <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="c-header__nav-link" style="display: inline-flex; align-items: center; gap: 4px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </a>
        {% endif %}

        {% if section.settings.show_cart_icon %}
          <a href="{{ routes.cart_url }}" class="c-header__action-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            <span>কার্ট</span>
            <span class="c-header__cart-count">{{ cart.item_count }}</span>
          </a>
        {% endif %}
      </div>

    </div>
  </header>
</div>

<!-- Slide-Out Navigation Drawer -->
{% if section.settings.enable_drawer_menu %}
  <div id="CustomDrawer-{{ section.id }}" class="c-drawer" aria-hidden="true" role="dialog">
    <div class="c-drawer__overlay" data-drawer-close></div>
    <div class="c-drawer__content">
      <div class="c-drawer__header">
        <span style="font-weight: 900; font-size: 16px;">মেনু নেভিগেশন</span>
        <button type="button" class="c-drawer__close" data-drawer-close aria-label="Close menu">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
      </div>

      <nav class="c-drawer__nav">
        <ul class="c-drawer__menu-list">
          {% for link in linklists[section.settings.menu].links %}
            <li class="c-drawer__menu-item">
              <div class="c-drawer__link-wrapper">
                <a href="{{ link.url }}" class="c-drawer__link {% if link.active %}is-active{% endif %}">
                  {{ link.title }}
                </a>
                {% if link.links != blank %}
                  <button type="button" class="c-drawer__toggle-btn" data-accordion-toggle aria-expanded="false">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
                  </button>
                {% endif %}
              </div>

              {% if link.links != blank %}
                <ul class="c-drawer__submenu-list" hidden>
                  {% for childlink in link.links %}
                    <li>
                      <div class="c-drawer__link-wrapper">
                        <a href="{{ childlink.url }}" class="c-drawer__childlink {% if childlink.active %}is-active{% endif %}">
                          {{ childlink.title }}
                        </a>
                        {% if childlink.links != blank %}
                          <button type="button" class="c-drawer__toggle-btn" data-accordion-toggle aria-expanded="false">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
                          </button>
                        {% endif %}
                      </div>

                      {% if childlink.links != blank %}
                        <ul class="c-drawer__grandchild-list" hidden>
                          {% for grandchildlink in childlink.links %}
                            <li>
                              <a href="{{ grandchildlink.url }}" class="c-drawer__grandchildlink {% if grandchildlink.active %}is-active{% endif %}">
                                {{ grandchildlink.title }}
                              </a>
                            </li>
                          {% endfor %}
                        </ul>
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </nav>
    </div>
  </div>
{% endif %}

<!-- Dynamic Carousel / Banner Slider -->
{% if section.settings.show_carousel and section.blocks.size > 0 %}
  <section class="c-carousel c-carousel--{{ section.settings.carousel_height }}" id="CustomCarousel-{{ section.id }}" data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.autoplay_speed | times: 1000 }}">
    <div class="c-carousel__track-container">
      <div class="c-carousel__track" data-carousel-track>
        {% for block in section.blocks %}
          <div class="c-carousel__slide c-carousel__slide--{{ block.settings.text_alignment }}" data-slide-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            
            <div class="c-carousel__overlay" style="background-color: {{ block.settings.overlay_color }}; opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"></div>
            
            <div class="c-carousel__image-wrapper">
              {% if block.settings.image != blank %}
                <picture>
                  {% if block.settings.image_mobile != blank %}
                    <source media="(max-width: 767px)" srcset="{{ block.settings.image_mobile | image_url: width: 800 }}">
                  {% endif %}
                  <img src="{{ block.settings.image | image_url: width: 2000 }}" alt="{{ block.settings.heading | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" class="c-carousel__image">
                </picture>
              {% else %}
                <div style="width: 100%; height: 100%; background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);"></div>
              {% endif %}
            </div>

            <div class="c-carousel__content-container">
              <div class="c-carousel__content" style="color: {{ block.settings.text_color }};">
                {% if block.settings.badge != blank %}
                  <span class="c-carousel__badge">{{ block.settings.badge }}</span>
                {% endif %}
                
                {% if block.settings.heading != blank %}
                  <h2 class="c-carousel__heading">{{ block.settings.heading }}</h2>
                {% endif %}

                {% if block.settings.subheading != blank %}
                  <p class="c-carousel__subheading">{{ block.settings.subheading }}</p>
                {% endif %}

                {% if block.settings.button_label != blank or block.settings.secondary_button_label != blank %}
                  <div class="c-carousel__buttons">
                    {% if block.settings.button_label != blank %}
                      <a href="{{ block.settings.button_link | default: routes.all_products_collection_url }}" class="c-btn c-btn--primary">
                        {{ block.settings.button_label }}
                      </a>
                    {% endif %}
                    {% if block.settings.secondary_button_label != blank %}
                      <a href="{{ block.settings.secondary_button_link | default: routes.collections_url }}" class="c-btn c-btn--secondary">
                        {{ block.settings.secondary_button_label }}
                      </a>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </div>

          </div>
        {% endfor %}
      </div>
    </div>

    {% if section.settings.show_arrows and section.blocks.size > 1 %}
      <button type="button" class="c-carousel__arrow c-carousel__arrow--prev" data-carousel-prev aria-label="Previous slide">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button type="button" class="c-carousel__arrow c-carousel__arrow--next" data-carousel-next aria-label="Next slide">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    {% endif %}

    {% if section.settings.show_dots and section.blocks.size > 1 %}
      <div class="c-carousel__dots" data-carousel-dots>
        {% for block in section.blocks %}
          <button type="button" class="c-carousel__dot {% if forloop.first %}is-active{% endif %}" data-dot-index="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
        {% endfor %}
      </div>
    {% endif %}
  </section>
{% endif %}

<!-- SECTION JAVASCRIPT -->
<script>
  (function() {
    // 1. Drawer Navigation Controller
    const drawer = document.getElementById('CustomDrawer-{{ section.id }}');
    const openBtns = document.querySelectorAll('[data-drawer-open]');
    const closeBtns = document.querySelectorAll('[data-drawer-close]');

    if (drawer) {
      openBtns.forEach(btn => btn.addEventListener('click', () => {
        drawer.classList.add('is-open');
        drawer.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }));

      closeBtns.forEach(btn => btn.addEventListener('click', () => {
        drawer.classList.remove('is-open');
        drawer.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }));

      const accordionBtns = drawer.querySelectorAll('[data-accordion-toggle]');
      accordionBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const expanded = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', !expanded);
          const subMenu = btn.closest('.c-drawer__link-wrapper').nextElementSibling;
          if (subMenu) subMenu.hidden = expanded;
        });
      });
    }

    // 2. Touch-Responsive Carousel Controller
    const carouselSection = document.getElementById('CustomCarousel-{{ section.id }}');
    if (!carouselSection) return;

    const track = carouselSection.querySelector('[data-carousel-track]');
    const slides = Array.from(track.children);
    const prevBtn = carouselSection.querySelector('[data-carousel-prev]');
    const nextBtn = carouselSection.querySelector('[data-carousel-next]');
    const dotsContainer = carouselSection.querySelector('[data-carousel-dots]');
    const dots = dotsContainer ? Array.from(dotsContainer.children) : [];

    let currentIndex = 0;
    let autoplayTimer = null;
    let startX = 0;
    let currentX = 0;
    let isSwiping = false;

    const isAutoplay = carouselSection.dataset.autoplay === 'true';
    const autoplaySpeed = parseInt(carouselSection.dataset.speed) || 5000;

    function goToSlide(index) {
      if (index < 0) index = slides.length - 1;
      if (index >= slides.length) index = 0;
      
      currentIndex = index;
      track.style.transform = 'translateX(-' + (currentIndex * 100) + '%)';

      dots.forEach((dot, idx) => {
        dot.classList.toggle('is-active', idx === currentIndex);
      });
    }

    function nextSlide() { goToSlide(currentIndex + 1); }
    function prevSlide() { goToSlide(currentIndex - 1); }

    function startAutoplay() {
      if (isAutoplay && slides.length > 1) {
        stopAutoplay();
        autoplayTimer = setInterval(nextSlide, autoplaySpeed);
      }
    }

    function stopAutoplay() {
      if (autoplayTimer) clearInterval(autoplayTimer);
    }

    if (prevBtn) prevBtn.addEventListener('click', () => { prevSlide(); startAutoplay(); });
    if (nextBtn) nextBtn.addEventListener('click', () => { nextSlide(); startAutoplay(); });

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => {
        goToSlide(idx);
        startAutoplay();
      });
    });

    // Touch Swipe Support
    track.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      isSwiping = true;
      stopAutoplay();
    }, { passive: true });

    track.addEventListener('touchmove', (e) => {
      if (!isSwiping) return;
      currentX = e.touches[0].clientX;
    }, { passive: true });

    track.addEventListener('touchend', () => {
      if (!isSwiping) return;
      const diffX = startX - currentX;
      if (Math.abs(diffX) > 40) {
        if (diffX > 0) nextSlide();
        else prevSlide();
      }
      isSwiping = false;
      startAutoplay();
    });

    carouselSection.addEventListener('mouseenter', stopAutoplay);
    carouselSection.addEventListener('mouseleave', startAutoplay);

    startAutoplay();

    // Theme Editor Sync
    document.addEventListener('shopify:block:select', (e) => {
      if (e.detail.sectionId === '{{ section.id }}') {
        const slideIndex = parseInt(e.target.dataset.slideIndex);
        if (!isNaN(slideIndex)) goToSlide(slideIndex);
      }
    });
  })();
</script>

