      </div>
    </div>

    <!-- Feature 2 -->
    <div class="flex items-center gap-3.5 p-4 rounded-2xl bg-slate-50 border border-slate-200/80">
      <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-600 font-bold flex items-center justify-center shrink-0">
