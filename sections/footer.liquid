{% comment %}
  DeshiStore Professional Footer Section
{% endcomment %}

<footer class="bg-slate-950 text-white pt-12 pb-8 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
    
    <!-- Column 1: Brand Info -->
    <div class="space-y-4">
      <div class="flex items-center gap-2">
        <div class="w-9 h-9 rounded-xl bg-amber-500 text-slate-950 font-black text-lg flex items-center justify-center">
          {{ shop.name | slice: 0, 1 | uppercase }}
        </div>
        <span class="font-black text-xl text-white tracking-tight">
          {{ shop.name }}
        </span>
      </div>

      <p class="text-xs text-slate-400 leading-relaxed font-medium">
        {{ section.settings.about_text | default: 'বাংলাদেশের সেরা হাই-কনভার্সন ই-কমার্স ব্র্যান্ড। আমরা সরবরাহ করি ১০০% প্রিমিয়াম কোয়ালিটির পোশাক ও লাইফস্টাইল প্রোডাক্ট।' }}
      </p>

      <!-- Courier Partners Badge -->
      <div class="pt-2">
        <span class="text-[10px] uppercase tracking-wider font-extrabold text-amber-400 block mb-2">আমাদের ডেলিভারি পার্টনারসমূহ:</span>
        <div class="flex flex-wrap gap-1.5 text-[10px] font-bold text-slate-300">
          <span class="bg-slate-900 px-2.5 py-1 rounded-lg border border-slate-800">Steadfast Courier</span>
          <span class="bg-slate-900 px-2.5 py-1 rounded-lg border border-slate-800">Pathao Courier</span>
          <span class="bg-slate-900 px-2.5 py-1 rounded-lg border border-slate-800">RedX</span>
          <span class="bg-slate-900 px-2.5 py-1 rounded-lg border border-slate-800">Paperfly</span>
        </div>
      </div>
    </div>

    <!-- Column 2: Quick Links -->
    <div class="space-y-3">
      <h4 class="text-xs font-black text-amber-400 uppercase tracking-wider">গুরুত্বপূর্ণ লিংক</h4>
      <ul class="space-y-2 text-xs font-semibold text-slate-300">
        <li><a href="/" class="hover:text-amber-400 transition-colors">হোম পেজ</a></li>
        <li><a href="/collections/all" class="hover:text-amber-400 transition-colors">সব প্রোডাক্টস</a></li>
        <li><a href="/pages/order-tracking" class="hover:text-amber-400 transition-colors flex items-center gap-1.5 text-amber-400"><span>অর্ডার ট্র্যাকিং</span></a></li>
        <li><a href="/policies/privacy-policy" class="hover:text-amber-400 transition-colors">প্রাইভেসি পলিসি</a></li>
        <li><a href="/policies/terms-of-service" class="hover:text-amber-400 transition-colors">শর্তাবলী</a></li>
      </ul>
    </div>

    <!-- Column 3: Customer Care -->
    <div class="space-y-3">
      <h4 class="text-xs font-black text-amber-400 uppercase tracking-wider">গ্রাহক সেবা</h4>
      <div class="space-y-2 text-xs font-medium text-slate-300">
        <p class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>হটলাইন: {{ section.settings.phone_number | default: '+880 1700-000000' }}</span>
        </p>
        <p class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          <span>হোয়াটসঅ্যাপ: {{ section.settings.whatsapp_number | default: '+880 1700-000000' }}</span>
        </p>
        <p class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span>{{ section.settings.address | default: 'ঢাকা, বাংলাদেশ' }}</span>
        </p>
      </div>
    </div>

    <!-- Column 4: Payment Methods -->
    <div class="space-y-3">
      <h4 class="text-xs font-black text-amber-400 uppercase tracking-wider">পেমেন্ট মেথড</h4>
      <div class="p-4 bg-slate-900/90 rounded-2xl border border-slate-800 space-y-2">
        <div class="flex items-center gap-2 text-xs font-extrabold text-amber-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          <span>১০০% ক্যাশ অন ডেলিভারি (COD)</span>
        </div>
        <p class="text-[11px] text-slate-400 leading-snug">
          পণ্য হাতে পেয়ে কুরিয়ারম্যানের সামনে চেক করে মুল্য পরিশোধ করার সুবর্ণ সুযোগ।
        </p>
      </div>
    </div>

  </div>

  <!-- Bottom Bar -->
  <div class="max-w-7xl mx-auto px-4 pt-8 mt-8 border-t border-slate-900 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
    <p>&copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. All Rights Reserved.</p>
    <p class="text-[11px]">Designed & Powered for Bangladeshi E-Commerce</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer Section",
  "settings": [
    {
      "type": "textarea",
      "id": "about_text",
      "label": "About Brand Text",
      "default": "বাংলাদেশের সেরা হাই-কনভার্সন ই-কমার্স ব্র্যান্ড। আমরা সরবরাহ করি ১০০% প্রিমিয়াম কোয়ালিটির পোশাক ও লাইফস্টাইল প্রোডাক্ট।"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Hotline Phone",
      "default": "+880 1700-000000"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp Hotline",
      "default": "+880 1700-000000"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Store Address",
      "default": "মিরপুর, ঢাকা, বাংলাদেশ"
    }
  ],
  "presets": [
    {
      "name": "Footer Section"
    }
  ]
}
{% endschema %}
