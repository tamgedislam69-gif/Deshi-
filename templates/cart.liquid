<div class="max-w-3xl mx-auto px-4 py-12 text-center space-y-4">
  <h1 class="text-2xl font-bold text-slate-900">আপনার কার্ট (Cart)</h1>
  {% if cart.item_count > 0 %}
    <form action="/cart" method="post" class="space-y-4">
      <div class="divide-y divide-slate-200">
        {% for item in cart.items %}
          <div class="py-4 flex justify-between items-center text-left">
            <div>
              <p class="font-bold text-slate-900">{{ item.product.title }}</p>
              <p class="text-xs text-slate-500">{{ item.variant.title }}</p>
            </div>
            <p class="font-bold text-amber-600">৳{{ item.final_line_price | money_without_currency }}</p>
          </div>
        {% endfor %}
      </div>
      <button type="submit" name="checkout" class="w-full bg-amber-500 text-slate-950 font-bold py-3 rounded-xl">
        চেকআউট করুন
      </button>
    </form>
  {% else %}
    <p class="text-slate-500">আপনার কার্টে কোন পণ্য নেই।</p>
    <a href="/" class="inline-block bg-slate-900 text-white px-5 py-2.5 rounded-xl text-xs font-bold">শপে ফিরে যান</a>
  {% endif %}
</div>
